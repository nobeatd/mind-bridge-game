        { "kind": "say", "who": "해슬", "text": "우리 축제 때 밴드 하자. 여섯이면 딱이잖아." },
        { "kind": "say", "who": "서연", "text": "나 노래하는 거 좋아하는데." },
        { "kind": "say", "who": "지호", "text": "나도 꼭 끼워줘." },
        { "kind": "say", "who": "민서", "text": "나도 다룰 수 있는 악기가 있어." },
        { "kind": "say", "who": "도윤", "text": "그럼 곡부터 정하자." },
        { "kind": "narrate", "text": "해슬이 웃는다. 나까지 여섯이 축제 무대를 준비하게 되었다." }
