            { "kind": "narrate", "text": "해슬의 웃음이 멈춘다." },
            { "kind": "say", "who": "해슬", "text": "나도 연주 신경 써." },
            { "kind": "narrate", "text": "해슬이 잠깐 말을 고른다." },
            { "kind": "say", "who": "해슬", "text": "같이 준비한 느낌이 좋겠다는 거였는데." }
          ],
          "flags": ["recovery:S3-01-C"],
          "next": "S3-02"
        }
      }
