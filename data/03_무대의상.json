      "display": ["B", "C", "A"],
      "options": {
        "A": {
          "gesture": "두 사람을 번갈아 보며",
          "text": "잠깐, 우리 지금 색을 고르는 거야, 아니면 다 똑같이 맞출지를 정하는 거야? 그 둘이 섞여서 얘기가 계속 도는 것 같아.",
          "appropriate": true,
          "area": "mediation",
          "method": ["조2"],
          "response": [
            { "kind": "say", "who": "해슬", "text": "…아. 나는 둘 다 생각하고 말했네." },
            { "kind": "narrate", "text": "잠깐 뒤." },
            { "kind": "say", "who": "해슬", "text": "같이 서면 한 팀 같아 보이는 게 제일 좋아서. 색은 그다음이고." }
          ],
          "next": "S3-02"
        },
        "B": {
          "gesture": "해슬을 보며",
          "text": "난 남색 쪽이 나은데. 넌 왜 흰색이 더 좋아?",
