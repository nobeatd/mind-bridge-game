          "area": "mediation",
          "method": ["조6", "공3"],
          "response": [
            { "kind": "say", "who": "해슬", "text": "어두우면 무대에서 잘 안 보일까 봐." },
            { "kind": "narrate", "text": "잠깐 뒤." },
            { "kind": "say", "who": "해슬", "text": "근데 남색도 색만 맞추면 될 것 같긴 하네." }
